# BabyCharts Server – Environment Variables
# Copy this file to .env and adjust the values for your setup.

# Port the Express server listens on
PORT=3001

# Public URL of the app
APP_URL=http://localhost:3001

# Node environment
NODE_ENV=production

# JWT Secret for session authentication (optional, will auto-generate if empty)
JWT_SECRET=your_secure_random_jwt_secret_here

# Dev/Superadmin Account Email (unlocks dev options like demo data)
DEV_EMAIL=admin@babycharts.local
