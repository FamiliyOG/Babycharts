{
  "name": "babycharts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "lint": "oxlint",
    "lint:eslint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:html": "html-validate index.html",
    "lint:all": "oxlint && eslint . && npm run lint:css && npm run lint:html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/smoke.spec.js",
    "test:a11y": "playwright test e2e/a11y.spec.js",
    "test:watch": "vitest",
    "check:deadcode": "knip",
    "check:duplicates": "jscpd src server",
    "check:architecture": "depcruise src server --config .dependency-cruiser.cjs",
    "check:dependencies": "npm audit --audit-level=high",
    "check:snyk": "snyk test",
    "check:snyk-code": "snyk code test",
    "analyze:bundle": "vite build --mode analyze",
    "scan:code": "npm run format:check && npm run lint:all && npm run check:deadcode && npm run check:duplicates && npm run check:architecture",
    "scan:test": "npm test && npm run test:coverage",
    "scan:security": "npm run check:dependencies",
    "scan:full": "npm run scan:code && npm run scan:test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.38.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "puppeteer": "^25.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3",
    "speakeasy": "^2.0.0",
    "zod": "^4.5.4"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "html-validate": "^11.11.0",
    "jscpd": "^5.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.34.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
