<?xml version="1.0"?>
<Container version="2">
  <Name>Babycharts</Name>
  <Repository>ghcr.io/familiyog/babycharts:latest</Repository>
  <Registry>https://ghcr.io/</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/FamiliyOG/Babycharts/issues</Support>
  <Project>https://github.com/FamiliyOG/Babycharts</Project>
  <Overview>BabyCharts – Wachstumskurven (WHO Standards), Perzentilen-Tracker, deutsches U-Heft Vorsorge-Tracking, PDF-Server-Berichte und geteilte Familienverwaltung.</Overview>
  <Category>Tools: Health: Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:3001]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/FamiliyOG/Babycharts/main/unraid-template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/FamiliyOG/Babycharts/main/public/icon.png</Icon>
  <ExtraParams>--cap-add=SYS_ADMIN</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="3001" Default="3001" Mode="tcp" Description="Port für die Web-Oberfläche" Type="Port" Display="always" Required="true" Mask="false">3001</Config>
  <Config Name="Datenbank &amp; Medien" Target="/app/server/data" Default="/mnt/user/appdata/Babycharts/server/data" Mode="rw" Description="Speicherort für babycharts.sqlite, Backups und verschlüsselte Medien" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/Babycharts/server/data</Config>
  <Config Name="Node Environment" Target="NODE_ENV" Default="production" Mode="" Description="Node Environment" Type="Variable" Display="advanced" Required="false" Mask="false">production</Config>
  <Config Name="JWT Secret" Target="JWT_SECRET" Default="" Mode="" Description="Geheimer Schlüssel zur Verschlüsselung von Sitzungs-Tokens (optional, wird sonst automatisch generiert)" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="App URL" Target="APP_URL" Default="http://localhost:3001" Mode="" Description="Interne App-URL" Type="Variable" Display="advanced" Required="false" Mask="false">http://localhost:3001</Config>
  <Config Name="Dev Account Email" Target="DEV_EMAIL" Default="" Mode="" Description="E-Mail-Adresse des Dev/Superadmin Accounts (schaltet Dev-Optionen wie Demo-Daten frei)" Type="Variable" Display="advanced" Required="false" Mask="false"/>
</Container>
